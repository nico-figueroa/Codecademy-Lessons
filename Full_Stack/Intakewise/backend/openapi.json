{
  "openapi": "3.1.0",
  "info": {
    "title": "Intakewise API",
    "version": "1.0.0",
    "description": "Account-scoped API for intake schedules, items, overrides, references, and review warnings. Information is organizational and is not medical advice."
  },
  "servers": [
    {
      "url": "/",
      "description": "Current API host"
    }
  ],
  "tags": [
    {
      "name": "Documentation"
    },
    {
      "name": "Health"
    },
    {
      "name": "Authentication"
    },
    {
      "name": "Items"
    },
    {
      "name": "Calendar"
    },
    {
      "name": "Overrides"
    },
    {
      "name": "Interactions"
    },
    {
      "name": "References"
    },
    {
      "name": "Stock"
    },
    {
      "name": "Administration"
    }
  ],
  "paths": {
    "/": {
      "get": {
        "tags": [
          "Documentation"
        ],
        "summary": "Open Swagger UI",
        "security": [],
        "responses": {
          "200": {
            "description": "Interactive API documentation",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "tags": [
          "Documentation"
        ],
        "summary": "Get this OpenAPI specification",
        "security": [],
        "responses": {
          "200": {
            "description": "OpenAPI 3.1 specification",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Check API availability",
        "security": [],
