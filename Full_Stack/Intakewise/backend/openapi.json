    "/api/auth/refresh": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Rotate a refresh token",
        "security": [],
        "requestBody": {
          "$ref": "#/components/requestBodies/RefreshToken"
        },
        "responses": {
          "200": {
            "description": "Rotated account and token pair",
