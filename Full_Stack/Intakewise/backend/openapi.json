    "/api/interactions": {
      "get": {
        "tags": [
          "Interactions"
        ],
        "summary": "Get source-linked warnings and schedule review notices",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Per-item warnings; not clinical determinations",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "interactions"
                  ],
                  "properties": {
                    "interactions": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/InteractionResult"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/api/reference/{itemId}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/ReferenceItemId"
        }
      ],
      "get": {
        "tags": [
          "References"
        ],
        "summary": "Get a cached public drug-label profile for an item",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Official-source profile",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "reference"
                  ],
                  "properties": {
                    "reference": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/api/reference/{itemId}/candidates": {
      "parameters": [
        {
          "$ref": "#/components/parameters/ReferenceItemId"
        }
      ],
      "get": {
        "tags": [
          "References"
        ],
        "summary": "Search and rank DailyMed label candidates for manual label review",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Search term (defaults to the item name)",
            "schema": {
              "type": "string",
              "maxLength": 160
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Ranked label candidates",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "query",
                    "candidates",
                    "excludedCount",
                    "current"
                  ],
                  "properties": {
                    "query": {
                      "type": "string"
                    },
                    "candidates": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "setid",
                          "title",
                          "score",
                          "confidence"
                        ],
                        "properties": {
                          "setid": {
                            "type": "string"
                          },
                          "title": {
                            "type": "string"
                          },
                          "brand": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "generic": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "labeler": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "form": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "score": {
                            "type": "number"
                          },
                          "confidence": {
                            "type": "string",
                            "enum": [
                              "high",
                              "medium",
                              "low",
                              "confirmed"
                            ]
                          },
                          "reasons": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "url": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "excludedCount": {
                      "type": "integer"
                    },
                    "current": {
                      "type": "object",
                      "properties": {
                        "status": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "setid": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "title": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "502": {
            "description": "DailyMed search failed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/reference/{itemId}/match": {
      "parameters": [
        {
          "$ref": "#/components/parameters/ReferenceItemId"
        }
      ],
      "put": {
        "tags": [
          "References"
        ],
        "summary": "Confirm a DailyMed label, mark that no official label exists, or reset to automatic matching",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "status"
                ],
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": [
                      "confirmed",
                      "no_label",
                      "auto"
                    ]
                  },
                  "setid": {
                    "type": "string",
                    "pattern": "^[a-fA-F0-9-]{8,64}$",
                    "description": "Required when status is confirmed"
                  },
                  "title": {
                    "type": "string",
                    "maxLength": 500
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated item",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "item"
                  ],
                  "properties": {
                    "item": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
