                      "items": {
                        "$ref": "#/components/schemas/Override"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      },
      "post": {
        "tags": [
          "Overrides"
        ],
        "summary": "Create or replace an intake override",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "$ref": "#/components/requestBodies/Override"
        },
        "responses": {
          "201": {
            "description": "Saved override",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "override"
                  ],
                  "properties": {
                    "override": {
                      "$ref": "#/components/schemas/Override"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          }
        }
      }
    },
    "/api/overrides/{id}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/OverrideId"
        }
      ],
      "put": {
        "tags": [
          "Overrides"
        ],
        "summary": "Update an override",
        "security": [
