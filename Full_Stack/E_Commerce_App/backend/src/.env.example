# Copy this file to `.env` (same folder) and fill in real values.
# Never commit the real `.env` file — it is already gitignored.

# --- Database ------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ecommerce
DB_USER=ecom_api_user
DB_PASSWORD=change-me
DB_SSL=false
# On Render, use the managed Postgres "External Database URL" instead and
# set DB_SSL=true. DATABASE_URL takes precedence over the discrete DB_* vars
# when both are present.
DATABASE_URL=

# --- Auth ------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# URL of the deployed/local frontend. Used to build OAuth redirect targets
# and as the default allowed CORS origin.
FRONTEND_URL=http://localhost:5173

# Comma-separated list of origins allowed to call this API (CORS).
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# --- GitHub OAuth ------------------------------------------------------------
# Create an OAuth App at https://github.com/settings/developers.
# Homepage URL: the frontend URL above. GitHub OAuth Apps support up to 10
# callback URLs, so you can register both the local and production callback
# on the same app, e.g.:
#   http://localhost:3000/auth/oauth/github/callback
#   https://<your-backend>.onrender.com/auth/oauth/github/callback
# The callback URL registered on GitHub must exactly match GITHUB_REDIRECT_URI
# below for whichever environment is running.
GITHUB_CLIENT_ID=replace-with-your-github-oauth-client-id
GITHUB_CLIENT_SECRET=replace-with-your-github-oauth-client-secret
GITHUB_REDIRECT_URI=http://localhost:3000/auth/oauth/github/callback

# --- Stripe (test/sandbox mode) ---------------------------------------------
# Keys: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_replace_me

# Webhook signing secret. For local development, run the Stripe CLI and use
# the whsec_... it prints (regenerated every time you restart `stripe listen`):
#   stripe listen --forward-to localhost:3000/payments/webhook \
#     --events payment_intent.succeeded,payment_intent.payment_failed
# For production, create a webhook endpoint at
# https://dashboard.stripe.com/test/webhooks pointing at
# https://<your-backend>.onrender.com/payments/webhook, subscribed to the
# same two events, and use the signing secret it generates.
STRIPE_WEBHOOK_SECRET=whsec_replace_me
